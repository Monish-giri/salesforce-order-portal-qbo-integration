<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Resolution_Before_Approval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, "Approved"),
    ISBLANK(TEXT(Resolution_Type__c))
)</errorConditionFormula>
    <errorMessage>Select a Resolution Type before approving the return request.</errorMessage>
</ValidationRule>
