<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false" cache="false" cspHeader="true">
    <html>
        <head>
            <title>Secure Razorpay Checkout</title>
            <style>
                html, body {
                    margin: 0;
                    padding: 0;
                    width: 100%;
                    height: 100%;
                    background: #f5f7fa;
                    font-family: Arial, sans-serif;
                }
                .status {
                    min-height: 100vh;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    text-align: center;
                    color: #24324a;
                }
                .card {
                    width: min(420px, 90vw);
                    padding: 32px;
                    background: #fff;
                    border: 1px solid #d8dee8;
                    border-radius: 12px;
                    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
                }
                .spinner {
                    width: 28px;
                    height: 28px;
                    margin: 0 auto 16px;
                    border: 3px solid #d8dee8;
                    border-top-color: #1769aa;
                    border-radius: 50%;
                    animation: spin 0.8s linear infinite;
                }
                @keyframes spin { to { transform: rotate(360deg); } }
            </style>
            <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
        </head>
        <body>
            <div class="status">
                <div class="card">
                    <div class="spinner"></div>
                    <div id="statusText">Opening secure payment...</div>
                </div>
            </div>

            <script>
                (function () {
                    var params = new URLSearchParams(window.location.search);
                    var keyId = params.get('keyId');
                    var amount = params.get('amount');
                    var currency = params.get('currency') || 'INR';
                    var orderId = params.get('orderId');
                    var receipt = params.get('receipt');
                    var parentOrigin = params.get('parentOrigin');
                    var statusText = document.getElementById('statusText');

                    function sendMessage(type, payload) {
                        if (!window.opener || !parentOrigin) {
                            return;
                        }

                        window.opener.postMessage({
                            type: type,
                            payload: payload || {}
                        }, parentOrigin);
                    }

                    function closeBridge() {
                        window.setTimeout(function () {
                            window.close();
                        }, 250);
                    }

                    function fail(message) {
                        statusText.textContent = message;
                        sendMessage('razorpay-error', { message: message });
                    }

                    if (!keyId || !amount || !orderId || !parentOrigin) {
                        fail('Payment session is incomplete. Please return to the order and try again.');
                        return;
                    }

                    if (typeof Razorpay !== 'function') {
                        fail('Unable to load Razorpay Checkout.');
                        return;
                    }

                    var options = {
                        key: keyId,
                        amount: Number(amount),
                        currency: currency,
                        name: 'Order Portal',
                        description: 'Online payment',
                        order_id: orderId,
                        notes: {
                            receipt: receipt || ''
                        },
                        handler: function (response) {
                            sendMessage('razorpay-success', {
                                razorpayPaymentId: response && response.razorpay_payment_id,
                                razorpayOrderId: response && response.razorpay_order_id,
                                razorpaySignature: response && response.razorpay_signature
                            });
                            statusText.textContent = 'Payment received. Returning to Order Portal...';
                            closeBridge();
                        },
                        modal: {
                            ondismiss: function () {
                                sendMessage('razorpay-dismissed', {});
                                closeBridge();
                            }
                        }
                    };

                    try {
                        var checkout = new Razorpay(options);
                        checkout.on('payment.failed', function (response) {
                            var error = response && response.error;
                            sendMessage('razorpay-error', {
                                message: error && error.description
                                    ? error.description
                                    : 'Razorpay payment failed.'
                            });
                        });
                        checkout.open();
                    } catch (error) {
                        fail(error && error.message ? error.message : 'Unable to open Razorpay Checkout.');
                    }
                }());
            </script>
        </body>
    </html>
</apex:page>
