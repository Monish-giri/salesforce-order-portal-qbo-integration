<aura:component controller="OrderlyLoginController" implements="forceCommunity:availableForAllPageTypes" access="global">
    <aura:attribute name="username" type="String"/>
    <aura:attribute name="password" type="String"/>
    <aura:attribute name="errorMessage" type="String"/>
    <div class="orderly-login-page">
        <div class="orderly-brand">
            <div class="orderly-mark">O</div>
            <span>Orderly</span>
        </div>
        <section class="orderly-card">
            <div class="orderly-eyebrow">CUSTOMER &amp; PARTNER PORTAL</div>
            <h1>Welcome back</h1>
            <p class="orderly-subtitle">Sign in to continue to your orders.</p>
            <aura:if isTrue="{!not(empty(v.errorMessage))}">
                <div class="orderly-error" role="alert">{!v.errorMessage}</div>
            </aura:if>
            <div class="orderly-field">
                <label for="orderly-username">Username</label>
                <lightning:input aura:id="usernameInput" name="username" type="text" variant="label-hidden"
                    value="{!v.username}" placeholder="Enter your Salesforce username" required="true"/>
            </div>
            <div class="orderly-field">
                <label for="orderly-password">Password</label>
                <lightning:input aura:id="passwordInput" name="password" type="password" variant="label-hidden"
                    value="{!v.password}" placeholder="Enter your password" required="true"/>
            </div>
            <button class="orderly-submit" onclick="{!c.handleLogin}">Sign in</button>
            <div class="orderly-forgot">
                <a href="{!$Site.BaseUrl + '/secur/forgotpassword.jsp'}">Forgot password?</a>
            </div>
        </section>
        <footer class="orderly-footer">Secure access powered by Salesforce</footer>
    </div>
</aura:component>